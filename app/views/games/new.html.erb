<div class="home-page">
    <header class="home-hero">
        <div class="logo-container">
            <h1 class="game-logo">BREAK<br><span class="game-logo__accent">THE CODE</span></h1>
            <div class="logo-glow"></div>
        </div>
        <p class="home-tagline">A 4-digit logic puzzle. Crack the code in as few guesses as you can.</p>
    </header>

    <section class="home-howto" aria-labelledby="howto-title">
        <h2 id="howto-title" class="home-howto__title">How to play</h2>
        <p class="home-howto__intro">Guess 4 unique digits (1–9). After each guess you get feedback:</p>
        <ul class="home-howto__list">
            <li class="home-howto__item">
                <span class="home-howto__badge right-number-right-place" aria-hidden="true"></span>
                <span class="home-howto__text"><strong>Correct</strong> — right digit, right spot</span>
            </li>
            <li class="home-howto__item">
                <span class="home-howto__badge right-number-wrong-place" aria-hidden="true"></span>
                <span class="home-howto__text"><strong>Misplaced</strong> — right digit, wrong spot</span>
            </li>
            <li class="home-howto__item">
                <span class="home-howto__badge wrong" aria-hidden="true"></span>
                <span class="home-howto__text"><strong>Miss</strong> — not in the code</span>
            </li>
        </ul>
    </section>

    <div class="home-cta">
        <%= form_with model: @game, local: true do |form| %>
        <%= form.submit "Start New Game", class: "home-cta__button" %>
        <% end %>
        <div class="start-button-glow"></div>
    </div>

    <div class="decoration-elements" aria-hidden="true">
        <div class="deco-circle circle1"></div>
        <div class="deco-circle circle2"></div>
        <div class="deco-circle circle3"></div>
    </div>
</div>
