<% if @game.won? %>
<div class="game-page_over_message success">
    <h2>Congratulations! 🎉</h2>
    <p><%= notice %></p>

    <% breakdown = @game.score_breakdown %>
    <div class="score-breakdown" aria-label="Score breakdown">
        <div class="score-breakdown__final">
            <span class="score-breakdown__final-label">Score</span>
            <span class="score-breakdown__final-value"><%= breakdown[:final] %></span>
        </div>
        <ul class="score-breakdown__rows">
            <li><span>Base</span><span>+<%= breakdown[:base] %></span></li>
            <li><span>Attempts (<%= @game.attempts %>)</span><span>−<%= breakdown[:attempt_penalty] %></span></li>
            <li><span>Time</span><span>−<%= breakdown[:time_penalty] %></span></li>
            <% if breakdown[:hint_penalty] > 0 %>
                <li><span>Hints (<%= @game.hints_used %>)</span><span>−<%= breakdown[:hint_penalty] %></span></li>
            <% end %>
            <li><span><%= @game.difficulty.capitalize %> multiplier</span><span>×<%= breakdown[:multiplier] %></span></li>
        </ul>
    </div>

    <% if @game.achievements.any? %>
        <div class="achievements" aria-label="Achievements earned">
            <p class="achievements__title">Achievements</p>
            <ul class="achievements__list">
                <% @game.achievements.each do |badge| %>
                    <li class="achievement achievement--<%= badge %>">
                        <span class="achievement__name"><%= achievement_label(badge) %></span>
                    </li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <% if @game.winner_name.blank? %>
        <div class="winner-name-capture">
            <p class="winner-name-capture__prompt">Add your name to the leaderboard</p>
            <%= form_with model: @game, url: game_path(@game), method: :patch, local: true, class: "winner-name-capture__form" do |f| %>
                <%= f.text_field :winner_name, placeholder: "Your name", maxlength: 24, required: true, class: "winner-name-capture__input", autocomplete: "off" %>
                <%= f.submit "Save", class: "winner-name-capture__submit" %>
            <% end %>
        </div>
    <% else %>
        <p class="winner-name-capture__saved">Saved as <strong><%= @game.winner_name %></strong> on the leaderboard.</p>
    <% end %>

    <div class="social-sharing"
         data-share-title="Break the Code"
         data-share-text="<%= share_text(@game) %>"
         data-share-url="<%= game_url(@game) %>"
         data-share-message="<%= share_message(@game) %>">
        <p class="social-sharing-text">Share your victory</p>

        <button type="button" class="share-native-btn" data-native-share hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                <polyline points="16 6 12 2 8 6"/>
                <line x1="12" y1="2" x2="12" y2="15"/>
            </svg>
            <span>Share to Stories &amp; more</span>
        </button>

        <div class="share-grid">
            <%= link_to share_on_whatsapp(@game),
                target: "_blank",
                rel: "noopener noreferrer",
                class: "share-chip whatsapp",
                title: "Share on WhatsApp",
                "aria-label": "Share on WhatsApp" do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.488"/>
                </svg>
            <% end %>

            <%= link_to share_on_twitter(@game),
                target: "_blank",
                rel: "noopener noreferrer",
                class: "share-chip x",
                title: "Share on X (Twitter)",
                "aria-label": "Share on X" do %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
            <% end %>

            <%= link_to share_on_facebook(@game),
                target: "_blank",
                rel: "noopener noreferrer",
                class: "share-chip facebook",
                title: "Share on Facebook",
                "aria-label": "Share on Facebook" do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
            <% end %>

            <%= link_to share_on_telegram(@game),
                target: "_blank",
                rel: "noopener noreferrer",
                class: "share-chip telegram",
                title: "Share on Telegram",
                "aria-label": "Share on Telegram" do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                </svg>
            <% end %>

            <%= link_to share_on_reddit(@game),
                target: "_blank",
                rel: "noopener noreferrer",
                class: "share-chip reddit",
                title: "Share on Reddit",
                "aria-label": "Share on Reddit" do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12.5c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
                </svg>
            <% end %>

            <%= link_to share_on_linkedin(@game),
                target: "_blank",
                rel: "noopener noreferrer",
                class: "share-chip linkedin",
                title: "Share on LinkedIn",
                "aria-label": "Share on LinkedIn" do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
            <% end %>

            <%= link_to share_via_email(@game),
                class: "share-chip email",
                title: "Share via Email",
                "aria-label": "Share via Email" do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <path d="m22 7-10 5L2 7"/>
                </svg>
            <% end %>

            <button type="button" class="share-chip copy" data-copy-link title="Copy link" aria-label="Copy link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
            </button>
        </div>
    </div>

    <div class="copy-notification" data-copy-toast role="status" aria-live="polite">Link copied!</div>

    <script>
        (function () {
            var root = document.currentScript.previousElementSibling;
            while (root && !root.classList.contains('game-page_over_message')) {
                root = root.previousElementSibling;
            }
            if (!root) return;

            var box = root.querySelector('.social-sharing');
            var toast = root.querySelector('[data-copy-toast]');
            if (!box) return;

            var title = box.dataset.shareTitle;
            var text = box.dataset.shareText;
            var url = box.dataset.shareUrl;
            var message = box.dataset.shareMessage;

            var nativeBtn = box.querySelector('[data-native-share]');
            if (nativeBtn && navigator.share) {
                nativeBtn.hidden = false;
                nativeBtn.addEventListener('click', function () {
                    navigator.share({ title: title, text: text, url: url }).catch(function () {});
                });
            }

            var copyBtn = box.querySelector('[data-copy-link]');
            if (copyBtn) {
                copyBtn.addEventListener('click', function () {
                    var done = function () {
                        if (!toast) return;
                        toast.classList.add('show');
                        setTimeout(function () { toast.classList.remove('show'); }, 1800);
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(message).then(done).catch(function () {
                            window.prompt('Copy this link:', message);
                        });
                    } else {
                        window.prompt('Copy this link:', message);
                    }
                });
            }
        })();
    </script>
</div>
<% end %>
<% if @game.over? && !@game.won? %>
<div class="game-page_over_message">
    <h2>Game Over!</h2>
    <p>The secret code was <span class="secret-code"><%= @game.secret_code %></span></p>
</div>
<% end %>
<% if @game.won? || @game.over? %>
<div class="game-page_over">
    <%= form_with url: games_path, method: :post, local: true, style: "display:contents" do |f| %>
        <%= f.hidden_field :difficulty, name: "game[difficulty]", value: @game.difficulty %>
        <%= f.submit "New Game", class: "game-page_over_button" %>
    <% end %>
    <%= link_to "Home", root_path, class: "game-page_over_button game-page_over_button--secondary" %>
</div>
<% end %>
