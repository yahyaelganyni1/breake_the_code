<div class="game-page">
    <header class="game-header">
        <h1 class="game-page_title">Break the Code</h1>
        <% guess_count = @game.guesses.size %>
        <div class="game-header__badges">
            <span class="difficulty-badge difficulty-badge--<%= @game.difficulty %>"><%= @game.difficulty.capitalize %></span>
            <% unless @game.over? || @game.won? %>
                <span class="game-header__meta">Guess <strong><%= guess_count + 1 %></strong> / <%= @game.max_attempts %></span>
            <% end %>
        </div>
    </header>

    <%= render "games/partials/gameover", game: @game %>

    <% unless @game.over? || @game.won? %>
    <% pool_max = @game.digit_pool.max %>
    <% pool_min = @game.digit_pool.min %>
    <% code_length = @game.code_length %>

    <% if @game.revealed_hints.any? %>
    <section class="hint-display" aria-label="Revealed hints">
        <p class="hint-display__label">Revealed</p>
        <ol class="hint-display__slots">
            <% (0...code_length).each do |pos| %>
                <% hint = @game.revealed_hints.find { |h| h["position"] == pos } %>
                <li class="hint-display__slot <%= 'hint-display__slot--revealed' if hint %>">
                    <%= hint ? hint["digit"] : "?" %>
                </li>
            <% end %>
        </ol>
    </section>
    <% end %>

    <%= form_with model: [@game, @guess], local: true, class: "game-page_form", data: { controller: "code-input" } do |form| %>
        <div class="code-input" role="group" aria-label="Enter your <%= code_length %>-digit guess">
            <% code_length.times do |i| %>
                <input type="text" inputmode="numeric" pattern="[<%= pool_min %>-<%= pool_max %>]" maxlength="1" autocomplete="off" class="code-input__cell" data-index="<%= i %>" aria-label="Digit <%= i + 1 %>" <%= 'autofocus' if i.zero? %>>
            <% end %>
            <%= form.hidden_field :code, id: "guess_code" %>
        </div>
        <p class="code-input__hint" id="code-hint">Use digits <%= pool_min %>–<%= pool_max %> only. No repeats.</p>

        <div class="game-actions">
            <%= form.submit "Submit Guess", class: "game-page_form_button", disabled: true, id: "submit-guess-btn" %>
            <button type="button"
                    class="hint-button"
                    id="hint-button"
                    data-game-token="<%= @game.token %>"
                    data-hints-remaining="<%= @game.hints_remaining %>"
                    <%= 'disabled' if @game.hints_remaining <= 0 %>>
                Reveal a digit
                <span class="hint-button__counter">(<span id="hints-remaining"><%= @game.hints_remaining %></span> left · −<%= Game::HINT_PENALTY %>)</span>
            </button>
        </div>
    <% end %>

    <script>
        (function () {
            const cells = Array.from(document.querySelectorAll('.code-input__cell'));
            const hiddenInput = document.getElementById('guess_code');
            const submitBtn = document.getElementById('submit-guess-btn');
            const hint = document.getElementById('code-hint');
            const codeLength = <%= code_length %>;
            const poolMin = <%= pool_min %>;
            const poolMax = <%= pool_max %>;
            const digitRegex = new RegExp('[^' + poolMin + '-' + poolMax + ']', 'g');
            if (!cells.length || !hiddenInput || !submitBtn) return;

            function currentCode() {
                return cells.map(c => c.value).join('');
            }

            function validate() {
                const code = currentCode();
                const digits = code.split('');
                const unique = new Set(digits);
                const allFilled = code.length === codeLength;
                const noDuplicates = unique.size === digits.length;
                const validRange = digits.every(d => {
                    const n = parseInt(d, 10);
                    return n >= poolMin && n <= poolMax;
                });
                const valid = allFilled && noDuplicates && validRange;

                hiddenInput.value = code;
                submitBtn.disabled = !valid;

                if (!allFilled) {
                    hint.textContent = 'Use digits ' + poolMin + '–' + poolMax + ' only. No repeats.';
                    hint.classList.remove('code-input__hint--error');
                } else if (!validRange) {
                    hint.textContent = 'Only digits ' + poolMin + '–' + poolMax + ' allowed.';
                    hint.classList.add('code-input__hint--error');
                } else if (!noDuplicates) {
                    hint.textContent = 'Each digit must be unique.';
                    hint.classList.add('code-input__hint--error');
                } else {
                    hint.textContent = 'Ready! Tap Submit.';
                    hint.classList.remove('code-input__hint--error');
                }
            }

            cells.forEach((cell, idx) => {
                cell.addEventListener('input', (e) => {
                    const v = cell.value.replace(digitRegex, '');
                    cell.value = v.slice(-1);
                    if (cell.value && idx < cells.length - 1) {
                        cells[idx + 1].focus();
                    }
                    validate();
                });

                cell.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && !cell.value && idx > 0) {
                        cells[idx - 1].focus();
                        cells[idx - 1].value = '';
                        validate();
                        e.preventDefault();
                    } else if (e.key === 'ArrowLeft' && idx > 0) {
                        cells[idx - 1].focus();
                        e.preventDefault();
                    } else if (e.key === 'ArrowRight' && idx < cells.length - 1) {
                        cells[idx + 1].focus();
                        e.preventDefault();
                    } else if (e.key === 'Enter') {
                        e.preventDefault();
                        if (!submitBtn.disabled) submitBtn.form.requestSubmit(submitBtn);
                    }
                });

                cell.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(digitRegex, '').slice(0, codeLength);
                    pasted.split('').forEach((d, i) => {
                        if (cells[i]) cells[i].value = d;
                    });
                    const next = Math.min(pasted.length, cells.length - 1);
                    cells[next].focus();
                    validate();
                });

                cell.addEventListener('focus', () => cell.select());
            });

            const form = submitBtn.form;
            let submitting = false;
            form.addEventListener('submit', (e) => {
                if (submitting) { e.preventDefault(); return; }
                submitting = true;
                submitBtn.disabled = true;
            });

            const hintBtn = document.getElementById('hint-button');
            const hintsRemainingEl = document.getElementById('hints-remaining');
            if (hintBtn) {
                hintBtn.addEventListener('click', async () => {
                    if (hintBtn.disabled) return;
                    hintBtn.disabled = true;
                    const token = hintBtn.dataset.gameToken;
                    const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
                    try {
                        const res = await fetch(`/games/${token}/hints`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
                        });
                        if (!res.ok) {
                            hintBtn.disabled = false;
                            return;
                        }
                        window.location.reload();
                    } catch (err) {
                        hintBtn.disabled = false;
                    }
                });
            }
        })();
    </script>
    <% end %>

    <% if @game.guesses.any? %>
    <section class="guesses-section">
        <header class="guesses-header">
            <h2>Your Guesses</h2>
            <div class="legend" aria-label="Feedback legend">
                <span class="legend__item"><span class="right-number-right-place" aria-hidden="true"></span><span>spot</span></span>
                <span class="legend__item"><span class="right-number-wrong-place" aria-hidden="true"></span><span>digit</span></span>
                <span class="legend__item"><span class="wrong" aria-hidden="true"></span><span>miss</span></span>
            </div>
        </header>
        <ol class="game-page_guesses">
            <% @game.guesses.reverse.each_with_index do |guess, reverse_index| %>
            <% guess_number = @game.guesses.size - reverse_index %>
            <li class="game-page_guesses_guess_list_item">
                <div class="game-page_guesses_guess_list_item_the_guess">
                    <span class="guess-number" aria-label="Guess number"><%= guess_number %></span>
                    <span class="guess-code" aria-label="Your guess">
                        <% guess.code.each_char do |digit| %>
                        <span class="guess-code__digit"><%= digit %></span>
                        <% end %>
                    </span>
                </div>
                <div class="game-page_guesses_feedback" aria-label="Feedback">
                    <% guess.feedback.each_char.with_index do |number, index| %>
                    <span class="game-page_guesses_feedback_p" style="animation-delay: <%= index * 0.08 %>s">
                        <% if number == "1" %>
                        <span class="right-number-right-place" title="Right number, right place"></span>
                        <% elsif number == "2" %>
                        <span class="right-number-wrong-place" title="Right number, wrong place"></span>
                        <% elsif number == "3" %>
                        <span class="wrong" title="Wrong number"></span>
                        <% end %>
                    </span>
                    <% end %>
                </div>
            </li>
            <% end %>
        </ol>
    </section>
    <% end %>
</div>
